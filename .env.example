PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=crm_woocommerce

# Must match the "Secret" on the WooCommerce webhook
WOO_WEBHOOK_SECRET=change-me

# Orders still "processing" after this many days are flagged as delayed
DELAY_DAYS=3

# Email (optional). Leave SMTP_HOST empty = emails are simulated and only logged in the CRM
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CRM <no-reply@crm.local>

# AI (optional). Leave empty = rule-based fallback summary
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
