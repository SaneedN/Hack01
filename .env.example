PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=crm_woocommerce

# Must match the "Secret" on the WooCommerce webhook
WOO_WEBHOOK_SECRET=change-me

# Orders still "processing" after this many days are flagged as delayed
DELAY_DAYS=3

# Email (optional). Leave SMTP_HOST empty = emails are simulated and only logged in the CRM
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CRM <no-reply@crm.local>

# AI (optional). Leave empty = rule-based fallback summary
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Auth (required) ---
# Long random string used to sign login tokens, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# First admin account, created automatically on first start when no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- WooCommerce REST API (optional, enables "Sync from WooCommerce") ---
# WooCommerce -> Settings -> Advanced -> REST API -> Add key (Read access)
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Automation ---
# Delayed-order follow-up check runs every N minutes (0 = disabled; admins can still run it manually)
FOLLOWUP_INTERVAL_MINUTES=60
